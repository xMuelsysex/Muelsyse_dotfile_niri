// Personal Niri overrides.
// Keep machine-specific startup, gestures, and window rules here so upstream
// imports stay isolated.

binds {
    Alt+A hotkey-overlay-title="搜索文件 FSearch" { spawn "fsearch"; }

    // NyxNiri 星环启动器 (Star-Ring Radial Menu) — v2.3.0
    // 本地 Mod+S 已占用，星环改用 Ctrl+MouseForward；scratchpad 切换用 Mod+Grave（与上游一致）
    Ctrl+MouseForward repeat=false hotkey-overlay-title="星环菜单 Star-Ring Menu" { spawn "~/.config/niri/scripts/niri-scratch-menu.py"; }
    Mod+Grave hotkey-overlay-title="Scratchpad 终端 Scratchpad Terminal" { spawn "~/.config/niri/scripts/niri-scratch-toggle.sh" "kitty"; }
}

// Desktop hot corners are handled by Noctalia (bottom-right window switcher).
gestures {
    hot-corners {
        off
    }
}

// Use cached blur for Chrome to avoid continuous wallpaper sampling on the
// NVIDIA high-refresh compositor path.
window-rule {
    match app-id=r#"^google-chrome$"#
    opacity 0.9
    background-effect { blur true; xray true; }
}

// Enable on-demand VRR for common game/fullscreen surfaces.
// Output side is `variable-refresh-rate on-demand=true` in noctalia/outputs.kdl.
window-rule {
    match app-id=r#"steam_app_.*"#
    match app-id=r#"(?i)gamescope"#
    match app-id=r#"(?i)^minecraft"#
    match app-id=r#"(?i)^osu!"#
    variable-refresh-rate true
}

// Scratchpad 终端浮动（对应 scratch-toggle 的 kitty --app-id scratchpad）
window-rule {
    match app-id=r#"^scratchpad$"#
    open-floating true
    default-floating-position x=0 y=40 relative-to="top"
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.45; }
}
